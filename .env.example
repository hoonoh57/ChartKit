PORT=4000

# 실 투자 키
KIWOOM_REAL_APP_KEY=*
KIWOOM_REAL_SECRET_KEY=*

# 모의 투자 키
KIWOOM_MOCK_APP_KEY=*
KIWOOM_MOCK_SECRET_KEY=*

# 운영 투자 키
KIWOOM_APP_KEY=*
KIWOOM_SECRET_KEY=*

KIWOOM_MOCK=true
KIWOOM_EXCHANGE=ALL
KIWOOM_ADJUST_PRICE=1
DEFAULT_SYMBOL=000660

# Kiwoom REST / WebSocket defaults can be overridden when the official endpoint changes.
KIWOOM_REST_BASE_URL=https://mockapi.kiwoom.com
KIWOOM_WEBSOCKET_URL=wss://mockapi.kiwoom.com:10000/api/dostk/websocket
KIWOOM_MINUTE_CHART_API_ID=ka10080
KIWOOM_MINUTE_CHART_ENDPOINT=/api/dostk/chart
KIWOOM_TRADE_STRENGTH_API_ID=ka10046
KIWOOM_TRADE_STRENGTH_ENDPOINT=/api/dostk/mrkcond
KIWOOM_TRADE_STRENGTH_SYMBOL_FIELD=stk_cd
KIWOOM_TRADE_STRENGTH_TIMEFRAME_FIELD=
KIWOOM_TRADE_STRENGTH_COUNT_FIELD=
KIWOOM_TRADE_STRENGTH_PAGE_DELAY_MS=1200
KIWOOM_REALTIME_TYPE=0B
KIWOOM_LIVE_REFRESH_MS=3000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=*
MYSQL_DATABASE=stock_info

# CYBOS universe data is stored separately from the existing MYSQL_DATABASE.
CYBOS_MYSQL_DATABASE=cybos_market_data
