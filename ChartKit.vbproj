<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>ChartKit</RootNamespace>
    <AssemblyName>ChartKit</AssemblyName>
    <StartupObject>ChartKit.DemoProgram</StartupObject>
    <Nullable>disable</Nullable>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="DemoProgram.vb" />
    <Compile Include="UI\**\*.vb" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\ChartKit.Core\ChartKit.Core.vbproj" />
    <ProjectReference Include="src\ChartKit.DataSources\ChartKit.DataSources.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".env" Condition="Exists('.env')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include=".env.example">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
