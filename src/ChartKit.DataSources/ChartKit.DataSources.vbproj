<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ChartKit</RootNamespace>
    <AssemblyName>ChartKit.DataSources</AssemblyName>
    <Nullable>disable</Nullable>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\DataSources\**\*.vb"
             Link="DataSources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChartKit.Core\ChartKit.Core.vbproj" />
  </ItemGroup>
</Project>
