# ============================================================
# ChartKit Git 텍스트 및 줄바꿈 정책
# ============================================================

* text=auto

# Windows / VB.NET 소스
*.vb text eol=crlf
*.vbproj text eol=crlf
*.sln text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 플랫폼 독립 텍스트
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.webp binary
*.zip binary
*.7z binary
*.pdf binary
*.dll binary
*.exe binary
*.pdb binary