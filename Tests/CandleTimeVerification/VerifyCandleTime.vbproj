<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ChartKit</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>Off</OptionInfer>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.vb" />
    <Compile Include="..\..\Models\CandleItem.vb" Link="CandleItem.vb" />
    <Compile Include="..\..\Core\Backtesting\CausalCandleSelector.vb" Link="CausalCandleSelector.vb" />
    <Compile Include="..\..\Core\Realtime\RealtimeEventBuffer.vb" Link="RealtimeEventBuffer.vb" />
  </ItemGroup>
</Project>