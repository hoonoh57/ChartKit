# ── 키움 REST API 설정 ──
# 모의투자로 먼저 검증 권장: KIWOOM_MOCK=true
KIWOOM_MOCK=true

# 공통 키 (REAL/MOCK 개별 키가 없으면 이걸 사용)
KIWOOM_APP_KEY=
KIWOOM_SECRET_KEY=

# (선택) 실/모의 개별 키
KIWOOM_REAL_APP_KEY=
KIWOOM_REAL_SECRET_KEY=
KIWOOM_MOCK_APP_KEY=
KIWOOM_MOCK_SECRET_KEY=

# 거래소 / 수정주가 / 기본종목
KIWOOM_EXCHANGE=KRX
KIWOOM_ADJUST_PRICE=1
DEFAULT_SYMBOL=005930

# 차트에서 키움 실데이터를 쓸지 (false 면 랜덤 가짜데이터)
USE_KIWOOM=true
# server32 CYBOS HTTP API. 설정하면 백테스트 과거 봉은 Kiwoom REST 대신 이 서버를 사용합니다.
# CYBOS_API_URL=http://localhost:8082
